# ── Firebase Auth ─────────────────────────────────────────────────────────────
# Backend: Firebase Admin SDK — used to verify ID tokens server-side.
# Option A: path to the service account JSON file
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json
# Option B: inline JSON (useful in Docker/CI — set ONE of the two)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Frontend: Firebase JS SDK public config (served to browser via /auth/config)
FIREBASE_API_KEY=AIzaSy...
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id

# ── Models & providers ────────────────────────────────────────────────────────
# The SINGLE SOURCE OF TRUTH for providers/models/agent settings is the YAML file
# config/models.yaml — edit that to change the default model, add providers, or
# tune per-agent temperatures. Override its location here if needed:
MODELS_CONFIG_PATH=config/models.yaml

# LLM_PROVIDER is only the fallback default for the legacy env-based factory
# (shared/providers.py). The app's default now comes from config/models.yaml.
# Format: provider:model-name
LLM_PROVIDER=google_genai:gemini-3.5-flash

# ── API keys (server-side fallback per provider) ──────────────────────────────
# These are used when a user has NOT supplied their own key via the UI (BYOK).
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
MOONSHOT_API_KEY=

# ── BYOK encryption ───────────────────────────────────────────────────────────
# Optional: override the auto-generated encryption key. If unset, the app
# generates a Fernet key on first run and persists it to /app/data/.encryption_key
# (survives container restarts via the appdata Docker volume).
# For production, generate one manually and set it here:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=

# ── Database & Cache ──────────────────────────────────────────────────────────
# These are set automatically by docker-compose; override for local dev
DATABASE_URL=postgresql+asyncpg://devagent:devagent@localhost:5432/devagent
REDIS_URL=redis://localhost:6379/0

# ── Sandbox execution (optional) ──────────────────────────────────────────────
# When set, ALL generated-code execution (tests + previews) is delegated to the
# isolated sandbox service instead of running in-process. docker-compose sets
# this automatically to http://sandbox:8009. Leave blank for local/in-process.
SANDBOX_URL=

# ── Observability (optional) ──────────────────────────────────────────────────
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=project-7-ai-dev-agent
