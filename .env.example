# ── LLM Provider ──────────────────────────────────────────────────────────────
# Format: provider:model-name
# Options: google_genai:gemini-2.0-flash | openai:gpt-4o | anthropic:claude-opus-4-8
#          google_vertexai:gemini-2.0-flash-001 | bedrock:anthropic.claude-3-5-sonnet-20241022-v2:0
LLM_PROVIDER=google_genai:gemini-2.0-flash

# ── API Keys (set the one matching your provider) ─────────────────────────────
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Database & Cache ──────────────────────────────────────────────────────────
# These are set automatically by docker-compose; override for local dev
DATABASE_URL=postgresql+asyncpg://devagent:devagent@localhost:5432/devagent
REDIS_URL=redis://localhost:6379/0

# ── Observability (optional) ──────────────────────────────────────────────────
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=project-7-ai-dev-agent
